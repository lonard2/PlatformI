# Database configuration (SQLite by default — tests and local dev)
DATABASE_URL="file:./dev.db"

# Postgres for prod-parity (Phase 0): start it with `docker compose up -d db`,
# then use this URL. db.ts picks the driver adapter from the URL scheme,
# so no other change is needed. Works the same with a hosted URL (Neon).
# DATABASE_URL="postgresql://platformi:platformi@localhost:5433/platformi"

# OpenRouter AI API Key (Required for AI transit assistant features)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# NextAuth configuration
NEXTAUTH_SECRET="your-development-secret-key-32-chars-minimum-length-key"
NEXTAUTH_URL="http://localhost:3000"
