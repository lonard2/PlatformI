# Database configuration (SQLite by default — tests and local dev)
# NOTE: always use the prisma/-prefixed form. The Prisma CLI resolves
# relative file: URLs from the repo root while the app resolves them
# under prisma/ — file:./prisma/dev.db is the one form both agree on.
DATABASE_URL="file:./prisma/dev.db"

# Postgres for prod-parity (Phase 0): start it with `docker compose up -d db`,
# then use this URL. db.ts picks the driver adapter from the URL scheme,
# so no other change is needed. Works the same with a hosted URL (Neon).
# DATABASE_URL="postgresql://platformi:platformi@localhost:5433/platformi"

# OpenRouter AI API Key (Required for AI transit assistant features)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# NextAuth configuration
NEXTAUTH_SECRET="your-development-secret-key-32-chars-minimum-length-key"
NEXTAUTH_URL="http://localhost:3000"

# Operator + member session secrets (fail closed in production — the app
# refuses to boot with fallback secrets when NODE_ENV=production)
ADMIN_AUTH_SECRET="your-development-secret-key-32-chars-minimum-length-key"
MEMBER_AUTH_SECRET="your-development-member-secret-key-32-chars-minimum"

# Demo login presets (login page only). Server-side demo credentials are
# always refused in production; set to 0 to hide presets in staging too.
NEXT_PUBLIC_DEMO_MODE="1"

# Keyed CARTO basemap (optional — keyless OSM fallback is automatic)
# NEXT_PUBLIC_CARTO_API_KEY="your_carto_api_key_here"
