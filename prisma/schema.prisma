generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Region {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  countryCode             String   @default("ID")
  centerLatitude          Float
  centerLongitude         Float
  zoomLevel               Int      @default(12)
  boundaryCoordinatesJson String
  lines                   Line[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Line {
  id                      String            @id @default(cuid())
  regionId                String
  region                  Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  code                    String            @unique
  name                    String
  category                String
  mode                    String
  colorHex                String
  textColorHex            String
  fareType                String
  baseFareRp              Int
  farePerKmRp             Int
  maxFareRp               Int
  headwayMinutes          Int
  firstDeparture          String
  lastDeparture           String
  wilayah                 String?
  polylineCoordinatesJson String
  stops                   Stop[]
  vehicles                Vehicle[]
  disruptionAlerts        DisruptionAlert[]
  timetableRuns           TimetableRun[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Stop {
  id                   String   @id @default(cuid())
  lineId               String
  line                 Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  name                 String
  code                 String
  latitude             Float
  longitude            Float
  sequence             Int
  isInterchange        Boolean  @default(false)
  connectedLineIdsJson String
  facilitiesJson       String
  accessibleElevator   Boolean  @default(false)
  tactilePaving        Boolean  @default(false)
  wheelchairRamp       Boolean  @default(false)
  platformType         String?
  wilayah              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Vehicle {
  id                  String                @id @default(cuid())
  lineId              String
  line                Line                  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  vehicleCode         String                @unique
  name                String
  category            String
  mode                String
  currentLatitude     Float
  currentLongitude    Float
  headingDegrees      Float
  speedKmh            Float
  status              String
  crowdLevel          String
  acComfort           String
  coachbuilder        String
  chassis             String
  progressFraction    Float                 @default(0.0)
  currentSegmentIndex Int                   @default(0)
  nextStopId          String
  nextStopEtaSeconds  Int                   @default(0)
  runNumber           String?
  trainsetNumber      String?
  totalTrainsets      Int?
  carFormation        String?
  depotHome           String?
  fleetNumber         String?
  busRunNumber        String?
  licensePlate        String?
  operatorName        String?
  technicalSpec       TechnicalSpec?
  seatingDiagramJson  String?
  photos              PhotoGallery[]
  crowdsourceCheckIns CrowdsourceCheckIn[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model TechnicalSpec {
  id                 String   @id @default(cuid())
  vehicleId          String   @unique
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  coachbuilder       String
  chassisModel       String
  powertrain         String
  engineOutput       String
  torque             String
  transmission       String
  suspensionType     String
  lengthMeters       Float
  passengerCapacity  Int
  maxSpeedKmh        Int
  safetyFeaturesJson String
  historicalNotes    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PhotoGallery {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url          String
  caption      String
  photographer String
  tag          String
  createdAt    DateTime @default(now())
}

model DisruptionAlert {
  id                String    @id @default(cuid())
  lineId            String
  line              Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  title             String
  description       String
  severity          String
  status            String
  affectedStopsJson String
  startTime         DateTime  @default(now())
  estimatedEndTime  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CrowdsourceCheckIn {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId     String
  crowdLevel String
  acComfort  String
  note       String?
  weight     Float    @default(1.0)
  timestamp  DateTime @default(now())
}

model Ticket {
  id                String    @id @default(cuid())
  ticketNumber      String    @unique
  userId            String
  originStopId      String
  destinationStopId String
  legsJson          String
  totalFareRp       Int
  isJakLingkoCapped Boolean   @default(false)
  status            String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  rollingToken      String
  gateScannedAt     DateTime?
  guestEmail        String?
  guestPhone        String?
  idNumber          String?
  seatId            String?
  serviceClass      String?
  reservationCode   String    @unique @default(cuid())
  claimedByUserId   String?
  paymentStatus     String    @default("UNPAID")
  paidAt            DateTime?
  paymentRef        String?
  paymentMethod     String?
  idempotencyKey    String?   @unique
  refundReason      String?
  refundedAt        DateTime?
  confirmedBy       String?
  refundedBy        String?
}

model TimetableRun {
  id             String   @id @default(cuid())
  lineId         String
  line           Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  tripCode       String
  origin         String
  destination    String
  departureTime  String
  arrivalTime    String
  operatorName   String
  serviceClass   String?
  gateOrBay      String?
  notes          String?
  baggageBelt    String?
  daysOfWeekJson        String?
  stopTimesJson         String?
  tripType              String?  @default("REGULAR")
  divergenceReason      String?  @default("NONE")
  divergenceDescription String?
  terminatedEarlyStopId String?
  divergedFromStopId    String?
  operatorId            String?
  operator              IntercityOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  boardingPointIdsJson  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model IntercityOperator {
  id              String          @id @default(cuid())
  name            String
  mode            String
  serviceTier     String
  boardingPoints  BoardingPoint[]
  timetableRuns   TimetableRun[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BoardingPoint {
  id         String            @id @default(cuid())
  operatorId String
  operator   IntercityOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  label      String
  kind       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Member {
  id                    String      @id @default(cuid())
  phone                 String?     @unique
  email                 String?     @unique
  displayName           String
  passkeyCredentialJson String?
  passkeyCounter        Int         @default(0)
  role                  String      @default("MEMBER")
  verifiedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  savedTrips            SavedTrip[]
}

model SavedTrip {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduleRefreshRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  feedUrl         String
  feedFingerprint String   @default("")
  lineCount       Int      @default(0)
  stopRowCount    Int      @default(0)
  status          String
  errorsJson      String   @default("[]")
  driftJson       String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
